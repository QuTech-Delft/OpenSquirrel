/*
 * Quantum Fourier Transform (QFT) on 8 qubits.
 *
 * The QFT is the quantum analogue of the discrete Fourier transform.
 * It maps computational basis states to their frequency-domain
 * representation and is a key subroutine in many quantum algorithms,
 * including Shor's factoring algorithm and quantum phase estimation.
 * The decomposition applies a Hadamard gate to each qubit
 * followed by controlled phase rotations with successively halving
 * angles (pi/2, pi/4, ...), then reverses the qubit order with
 * SWAP gates.
 *
 */


version 3.0

qubit[8] q
bit[8] b


Rz(3.14) q[7]
Ry(1.57) q[7]
Rz(0.0) q[7]

Rz(0.785) q[7]
CNOT q[7],  q[6]
Rz(-0.785) q[6]
CNOT q[7],  q[6]
Rz(0.785) q[6]
Rz(3.14) q[6]
Ry(1.57) q[6]
Rz(0.0) q[6]

Rz(0.785) q[6]
Rz(0.3925) q[7]
CNOT q[7],  q[5]
Rz(-0.3925) q[5]
CNOT q[7],  q[5]
Rz(0.3925) q[5]
CNOT q[6],  q[5]
Rz(-0.785) q[5]
CNOT q[6],  q[5]
Rz(0.785) q[5]
Rz(3.14) q[5]
Ry(1.57) q[5]
Rz(0.0) q[5]

Rz(0.785) q[5]
Rz(0.3925) q[6]
Rz(0.19625) q[7]
CNOT q[7],  q[4]
Rz(-0.19625) q[4]
CNOT q[7],  q[4]
Rz(0.19625) q[4]
CNOT q[6],  q[4]
Rz(-0.3925) q[4]
CNOT q[6],  q[4]
Rz(0.3925) q[4]
CNOT q[5],  q[4]
Rz(-0.785) q[4]
CNOT q[5],  q[4]
Rz(0.785) q[4]
Rz(3.14) q[4]
Ry(1.57) q[4]
Rz(0.0) q[4]

Rz(0.785) q[4]
Rz(0.3925) q[5]
Rz(0.19625) q[6]
Rz(0.098125) q[7]
CNOT q[7],  q[3]
Rz(-0.098125) q[3]
CNOT q[7],  q[3]
Rz(0.098125) q[3]
CNOT q[6],  q[3]
Rz(-0.19625) q[3]
CNOT q[6],  q[3]
Rz(0.19625) q[3]
CNOT q[5],  q[3]
Rz(-0.3925) q[3]
CNOT q[5],  q[3]
Rz(0.3925) q[3]
CNOT q[4],  q[3]
Rz(-0.785) q[3]
CNOT q[4],  q[3]
Rz(0.785) q[3]
Rz(3.14) q[3]
Ry(1.57) q[3]
Rz(0.0) q[3]

Rz(0.785) q[3]
Rz(0.3925) q[4]
Rz(0.19625) q[5]
Rz(0.098125) q[6]
Rz(0.0490625) q[7]
CNOT q[7],  q[2]
Rz(-0.0490625) q[2]
CNOT q[7],  q[2]
Rz(0.0490625) q[2]
CNOT q[6],  q[2]
Rz(-0.098125) q[2]
CNOT q[6],  q[2]
Rz(0.098125) q[2]
CNOT q[5],  q[2]
Rz(-0.19625) q[2]
CNOT q[5],  q[2]
Rz(0.19625) q[2]
CNOT q[4],  q[2]
Rz(-0.3925) q[2]
CNOT q[4],  q[2]
Rz(0.3925) q[2]
CNOT q[3],  q[2]
Rz(-0.785) q[2]
CNOT q[3],  q[2]
Rz(0.785) q[2]
Rz(3.14) q[2]
Ry(1.57) q[2]
Rz(0.0) q[2]

Rz(0.785) q[2]
Rz(0.3925) q[3]
Rz(0.19625) q[4]
Rz(0.098125) q[5]
Rz(0.0490625) q[6]
Rz(0.02453125) q[7]
CNOT q[7],  q[1]
Rz(-0.02453125) q[1]
CNOT q[7],  q[1]
Rz(0.02453125) q[1]
CNOT q[6],  q[1]
Rz(-0.0490625) q[1]
CNOT q[6],  q[1]
Rz(0.0490625) q[1]
CNOT q[5],  q[1]
Rz(-0.098125) q[1]
CNOT q[5],  q[1]
Rz(0.098125) q[1]
CNOT q[4],  q[1]
