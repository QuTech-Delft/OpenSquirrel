CNOT q[3],  q[1]
Rz(0.3925) q[1]
CNOT q[2],  q[1]
Rz(-0.785) q[1]
CNOT q[2],  q[1]
Rz(0.785) q[1]
Rz(3.14) q[1]
Ry(1.57) q[1]
Rz(0.0) q[1]

Rz(0.785) q[1]
Rz(0.3925) q[2]
Rz(0.19625) q[3]
Rz(0.098125) q[4]
Rz(0.0490625) q[5]
Rz(0.02453125) q[6]
Rz(0.012265625) q[7]
CNOT q[7],  q[0]
Rz(-0.012265625) q[0]
CNOT q[7],  q[0]
Rz(0.012265625) q[0]
CNOT q[6],  q[0]
Rz(-0.02453125) q[0]
CNOT q[6],  q[0]
Rz(0.02453125) q[0]
CNOT q[5],  q[0]
Rz(-0.0490625) q[0]
CNOT q[5],  q[0]
Rz(0.0490625) q[0]
CNOT q[4],  q[0]
Rz(-0.098125) q[0]
CNOT q[4],  q[0]
Rz(0.098125) q[0]
CNOT q[3],  q[0]
Rz(-0.19625) q[0]
CNOT q[3],  q[0]
Rz(0.19625) q[0]
CNOT q[2],  q[0]
Rz(-0.3925) q[0]
CNOT q[2],  q[0]
Rz(0.3925) q[0]
CNOT q[1],  q[0]
Rz(-0.785) q[0]
CNOT q[1],  q[0]
Rz(0.785) q[0]
Rz(3.14) q[0]
Ry(1.57) q[0]
Rz(0.0) q[0]

CNOT q[0],  q[7]
CNOT q[1],  q[6]
CNOT q[2],  q[5]
CNOT q[3],  q[4]
CNOT q[4],  q[3]
CNOT q[3],  q[4]
CNOT q[5],  q[2]
CNOT q[2],  q[5]
CNOT q[6],  q[1]
CNOT q[1],  q[6]
CNOT q[7],  q[0]
CNOT q[0],  q[7]


b[0] = measure q[0]
b[1] = measure q[1]
b[2] = measure q[2]
b[3] = measure q[3]
b[4] = measure q[4]
b[5] = measure q[5]
b[6] = measure q[6]
b[7] = measure q[7]